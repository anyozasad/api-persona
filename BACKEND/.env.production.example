APP_NAME="Mallqui Gym"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-DOMINIO-AQUI
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mallqui_gym
DB_USERNAME=mallqui_app
DB_PASSWORD=CAMBIAR_POR_PASSWORD_FUERTE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

SANCTUM_EXPIRATION=480

MAIL_MAILER=smtp
MAIL_HOST=SMTP_DE_LA_EMPRESA
MAIL_PORT=587
MAIL_USERNAME=CORREO_SMTP
MAIL_PASSWORD=PASSWORD_SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@TU-DOMINIO-AQUI
MAIL_FROM_NAME="Mallqui Gym"

# En Windows/XAMPP puede apuntar a C:\\xampp\\mysql\\bin\\mysqldump.exe
MYSQLDUMP_PATH=mysqldump
